# Copy to `.dev.vars` for local wrangler (never commit `.dev.vars`).
# No production secrets belong in the repo.
# There is no DEV_MODE Approve switch.

AUTO_APPROVE_MAX=0

# Required for ALLOW_TEST_AUTH. wrangler.toml defaults ENVIRONMENT=production;
# without this override, ALLOW_TEST_AUTH=true is a hard Worker failure (N-3).
ENVIRONMENT=development

# Local-only MCP identity. Production wrangler.toml must leave this unset.
# When true, send: Authorization: Bearer test:<userId>
# Honored only on localhost / 127.0.0.1 with ENVIRONMENT=development.
ALLOW_TEST_AUTH=true

# Used to mint/verify Approve JWTs (HS256) and compact HMAC assertions.
# Generate your own for local use; never reuse in production.
APPROVAL_HMAC_SECRET=dev-only-hmac-secret-change-me

# Origin used when tools return approveUrl (wrangler dev default).
PUBLIC_BASE_URL=http://localhost:8787

# v1 (not implemented): per-tenant Revolut Business wizard credentials live in a vault.
# REVOLUT_CLIENT_ID=
# REVOLUT_CLIENT_SECRET=
